{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nonameisready.github.io/schemas/adjudication-worksheet-v1.json",
  "title": "Independent human worksheet for a candidate CS outcome",
  "type": "object",
  "required": ["worksheet_id", "question_id", "question_version", "endpoint", "reviewer_id", "review_started_at", "independence_declaration", "frozen_endpoint", "candidate_evidence", "match_checks", "dimension_decisions", "decision", "rationale", "limitations", "second_review_required", "review_status"],
  "properties": {
    "worksheet_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "minLength": 1},
    "question_version": {"type": "string", "minLength": 1},
    "endpoint": {"enum": ["attention", "resolution", "premise_revision", "evidence_growth", "impact"]},
    "reviewer_id": {"type": "string", "minLength": 1},
    "review_started_at": {"type": ["string", "null"], "format": "date-time"},
    "independence_declaration": {"type": "object", "required": ["authorship_or_collaboration", "prior_involvement", "conflicts", "independent_of_other_reviewer"], "properties": {"authorship_or_collaboration": {"type": ["string", "null"]}, "prior_involvement": {"type": ["string", "null"]}, "conflicts": {"type": ["string", "null"]}, "independent_of_other_reviewer": {"type": ["boolean", "null"]}}},
    "frozen_endpoint": {"type": "object", "required": ["source_question", "source_version", "cutoff", "observation_end", "object", "assumptions", "computational_model", "baseline", "metric_denominator", "threshold", "falsification_condition", "criterion_version"], "properties": {"source_question": {"type": ["string", "null"]}, "source_version": {"type": ["string", "null"]}, "cutoff": {"type": ["string", "null"], "format": "date-time"}, "observation_end": {"type": ["string", "null"], "format": "date-time"}, "object": {"type": ["string", "null"]}, "assumptions": {"type": ["string", "null"]}, "computational_model": {"type": ["string", "null"]}, "baseline": {"type": ["string", "null"]}, "metric_denominator": {"type": ["string", "null"]}, "threshold": {"type": ["string", "null"]}, "falsification_condition": {"type": ["string", "null"]}, "criterion_version": {"type": ["string", "null"]}}},
    "candidate_evidence": {"type": "array", "items": {"type": "object", "required": ["evidence_id", "url", "title", "version", "first_public_date", "primary_source", "hash", "locator", "summary"], "properties": {"evidence_id": {"type": "string"}, "url": {"type": ["string", "null"], "format": "uri"}, "title": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]}, "first_public_date": {"type": ["string", "null"], "format": "date"}, "primary_source": {"type": ["boolean", "null"]}, "hash": {"type": ["string", "null"]}, "locator": {"type": ["string", "null"]}, "summary": {"type": ["string", "null"]}}}},
    "match_checks": {"type": "object", "required": ["question_object", "assumptions", "computational_model", "baseline", "metric_denominator", "threshold_falsifier", "date_version", "independence", "evidence_completeness"], "properties": {"question_object": {"enum": ["MATCH", "MISMATCH", "UNCLEAR", "PENDING"]}, "assumptions": {"enum": ["MATCH", "MISMATCH", "UNCLEAR", "PENDING"]}, "computational_model": {"enum": ["MATCH", "MISMATCH", "UNCLEAR", "PENDING"]}, "baseline": {"enum": ["MATCH", "MISMATCH", "UNCLEAR", "PENDING"]}, "metric_denominator": {"enum": ["MATCH", "MISMATCH", "UNCLEAR", "PENDING"]}, "threshold_falsifier": {"enum": ["MATCH", "MISMATCH", "UNCLEAR", "PENDING"]}, "date_version": {"enum": ["MATCH", "MISMATCH", "UNCLEAR", "PENDING"]}, "independence": {"enum": ["MATCH", "MISMATCH", "UNCLEAR", "PENDING"]}, "evidence_completeness": {"enum": ["MATCH", "MISMATCH", "UNCLEAR", "PENDING"]}}, "additionalProperties": {"type": "object"}},
    "dimension_decisions": {"type": "object", "required": ["attention", "direct_resolution", "premise_refutation_or_revision", "substantive_evidence_progress", "contradiction", "computational_impact"], "properties": {"attention": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "UNRESOLVED", "MISSING_EVIDENCE", "NOT_YET_DUE", "NOT_APPLICABLE", "PENDING"]}, "direct_resolution": {"enum": ["SUPPORTED", "REFUTED", "VERIFIED_UNRESOLVED", "UNRESOLVED", "MISSING_EVIDENCE", "NOT_YET_DUE", "PENDING"]}, "premise_refutation_or_revision": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "UNRESOLVED", "MISSING_EVIDENCE", "NOT_YET_DUE", "PENDING"]}, "substantive_evidence_progress": {"enum": ["SUPPORTED", "VERIFIED_NO_PROGRESS", "UNRESOLVED", "MISSING_EVIDENCE", "NOT_YET_DUE", "PENDING"]}, "contradiction": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "UNRESOLVED", "MISSING_EVIDENCE", "NOT_YET_DUE", "PENDING"]}, "computational_impact": {"enum": ["SUPPORTED", "NOT_SUPPORTED", "UNRESOLVED", "MISSING_EVIDENCE", "NOT_YET_DUE", "PENDING"]}}, "additionalProperties": {"type": "object"}},
    "decision": {"enum": ["CANDIDATE_EVIDENCE_FOUND", "INDEPENDENTLY_ADJUDICATED_OUTCOME", "UNRESOLVED", "MISSING_EVIDENCE", "NOT_YET_DUE", "PENDING"]},
    "rationale": {"type": ["string", "null"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "second_review_required": {"const": true},
    "review_status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "SUBMITTED_INDEPENDENTLY", "AGREED", "DISAGREEMENT", "THIRD_REVIEW_PENDING", "UNRESOLVED_AFTER_REVIEW"]}
  }
}
