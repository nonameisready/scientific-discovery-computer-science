{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nonameisready.github.io/schemas/radar-endpoint-operationalization-v1.json",
  "title": "Prospective operationalization of an editorial CS radar item",
  "type": "object",
  "required": ["record_id", "record_created_at", "historical_baseline", "prospective_status", "created_after_baseline", "operationalization_freeze_at", "items", "all_items_freeze_ready", "frozen_forecast_count", "no_outcomes_created", "no_scores_created"],
  "properties": {
    "record_id": {"type": "string"},
    "record_created_at": {"type": "string", "format": "date-time"},
    "historical_baseline": {"type": "object", "required": ["baseline_id", "baseline_date", "baseline_type", "source_file", "source_sha256", "endpoint_was_frozen_in_baseline", "retroactive_forecast_claim_permitted"], "properties": {"baseline_id": {"type": "string"}, "baseline_date": {"type": "string", "format": "date"}, "baseline_type": {"const": "HISTORICAL_EDITORIAL_EVIDENCE_ONLY"}, "source_file": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "endpoint_was_frozen_in_baseline": {"const": false}, "retroactive_forecast_claim_permitted": {"const": false}}},
    "prospective_status": {"type": "string"},
    "created_after_baseline": {"const": true},
    "operationalization_freeze_at": {"type": ["string", "null"]},
    "freeze_rule": {"type": "string"},
    "shared_adjudication_rules": {"type": "object"},
    "items": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "required": ["item_id", "source_title", "horizon_if_frozen_now", "status", "readiness", "proposed_event", "success_evidence", "against_or_refutation", "missing_definition_fields", "reviewer_decisions_required", "axis_status", "uncertainty_sources"], "properties": {"item_id": {"type": "string"}, "source_title": {"type": "string"}, "horizon_if_frozen_now": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}}, "status": {"const": "PROPOSED_ENDPOINT"}, "readiness": {"type": "string"}, "proposed_event": {"type": "string"}, "success_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "against_or_refutation": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "missing_definition_fields": {"type": "array", "items": {"type": "string"}}, "reviewer_decisions_required": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "axis_status": {"type": "object", "required": ["attention", "direct_resolution", "premise_refutation_or_revision", "substantive_evidence_progress", "computational_impact"], "properties": {"attention": {"type": "string"}, "direct_resolution": {"type": "string"}, "premise_refutation_or_revision": {"type": "string"}, "substantive_evidence_progress": {"type": "string"}, "computational_impact": {"type": "string"}}}, "uncertainty_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "all_items_freeze_ready": {"const": false},
    "frozen_forecast_count": {"const": 0},
    "no_outcomes_created": {"const": true},
    "no_scores_created": {"const": true}
  }
}
