new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/mem_cache/kv_event_sink.py
@@
+"""Opt-in, best-effort KV event sink for experiments."""
+from __future__ import annotations
+import json
+import os
+import threading
+import time
+_LOCK = threading.Lock()
+
+def emit(event: dict) -> None:
+    path = os.environ.get("SGLANG_KV_EVENT_SINK")
+    if not path:
+        return
+    payload = dict(event)
+    payload.setdefault("schema", "agentic-kv/events/v1")
+    payload.setdefault("timestamp_ms", time.time_ns() // 1_000_000)
+    payload.setdefault("field_gap", [])
+    try:
+        with _LOCK, open(path, "a", encoding="utf-8") as handle:
+            handle.write(json.dumps(payload, sort_keys=True) + "\n")
+    except OSError:
+        return

